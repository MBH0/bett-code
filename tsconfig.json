{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "paths": {
      "bun:bundle": ["./src/shims/bun-bundle.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
